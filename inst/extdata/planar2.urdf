<?xml version="1.0"?>
<!-- Planar two-link arm with 1 m links and uniform 1 kg rods.
     Written for robotcompR; released under the package license (GPL-3). -->
<robot name="planar2_urdf">
  <link name="base"/>
  <link name="link1">
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0.0833333333333333" iyz="0" izz="0.0833333333333333"/>
    </inertial>
    <collision>
      <origin xyz="0.5 0 0" rpy="0 1.5707963267949 0"/>
      <geometry><capsule radius="0.05" length="1"/></geometry>
    </collision>
  </link>
  <link name="link2">
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0.0833333333333333" iyz="0" izz="0.0833333333333333"/>
    </inertial>
    <collision>
      <origin xyz="0.5 0 0" rpy="0 1.5707963267949 0"/>
      <geometry><capsule radius="0.05" length="1"/></geometry>
    </collision>
  </link>
  <link name="tool"/>
  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265358979" upper="3.14159265358979" effort="50" velocity="2"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265358979" upper="3.14159265358979" effort="30" velocity="2"/>
  </joint>
  <joint name="tool_joint" type="fixed">
    <parent link="link2"/>
    <child link="tool"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
  </joint>
</robot>
