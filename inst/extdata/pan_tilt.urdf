<?xml version="1.0"?>
<!-- Pan-tilt camera mount with a continuous pan joint, a revolute tilt
     joint with rpy origins, and a prismatic zoom stage. Written for
     robotcompR; released under the package license (GPL-3). -->
<robot name="pan_tilt">
  <link name="base">
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.1" length="0.1"/></geometry></collision>
  </link>
  <link name="pan">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0.3"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0001" ixz="0" iyy="0.003" iyz="0" izz="0.004"/>
    </inertial>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.08 0.12 0.1"/></geometry></collision>
  </link>
  <link name="tilt">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision><origin xyz="0.03 0 0"/><geometry><sphere radius="0.04"/></geometry></collision>
  </link>
  <link name="lens"/>
  <joint name="pan_joint" type="continuous">
    <parent link="base"/>
    <child link="pan"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan"/>
    <child link="tilt"/>
    <origin xyz="0 0 0.1" rpy="1.5707963267949 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="5" velocity="1"/>
  </joint>
  <joint name="zoom_joint" type="prismatic">
    <parent link="tilt"/>
    <child link="lens"/>
    <origin xyz="0.06 0 0" rpy="0 1.5707963267949 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.05" effort="1" velocity="0.1"/>
  </joint>
</robot>
